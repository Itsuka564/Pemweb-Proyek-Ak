# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE - SISTEM INFORMASI PENYEWAAN ASET
# Kelompok 10
# Salin file ini menjadi .env.local dan isi dengan kredensial nyata
# ========================================================

# Supabase Public & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Secret (HANYA DI SERVER, JANGAN DIEKSPOS KE BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Database URL
DATABASE_URL=postgresql://postgres.your-project:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Midtrans Payment Gateway (Sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_IS_PRODUCTION=false

# Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
